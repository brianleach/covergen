{
  "name": "covergen",
  "version": "0.1.0",
  "description": "Coverage-gated LLM test generation. Generates candidate tests, keeps only those that build, pass repeatedly, and strictly raise coverage.",
  "keywords": [
    "coverage",
    "test-generation",
    "llm",
    "claude",
    "anthropic",
    "vitest",
    "jest",
    "rspec",
    "bun",
    "lcov",
    "cli"
  ],
  "license": "MIT",
  "author": "Brian Leach",
  "homepage": "https://github.com/brianleach/covergen#readme",
  "repository": { "type": "git", "url": "git+https://github.com/brianleach/covergen.git" },
  "bugs": { "url": "https://github.com/brianleach/covergen/issues" },
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "covergen": "dist/cli.js" },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "idioms/",
    "covergen.example.yaml",
    "covergen.covergen.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "commander": "^13.1.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
